\":\"Biome\",\"jumpToDimension\":\"Jump to {dimension} and switch dimension\",\"pickAnyColor\":\"Pick any color\",\"customColorPicker\":\"Custom color picker\",\"colors\":{\"rose\":\"Rose\",\"orange\":\"Orange\",\"amber\":\"Amber\",\"green\":\"Green\",\"cyan\":\"Cyan\",\"blue\":\"Blue\",\"purple\":\"Purple\",\"white\":\"White\"},\"notesPlaceholder\":\"Notes (optional)\",\"underwater\":\"underwater\"},\"biomesPanel\":{\"heading\":\"Biomes\",\"outline\":\"Outline\",\"blackAndWhite\":\"Black and white\",\"selectedBiomes\":\"Selected biomes: {count}\",\"selectAll\":\"Select all\",\"clear\":\"Clear\",\"invert\":\"Invert\"},\"biomesPopover\":{\"newBadge\":\"NEW\",\"outline\":\"Outline\",\"blackAndWhite\":\"B\u0026W\",\"countSelected\":\"{count} selected\",\"searchPlaceholder\":\"Search biomes...\",\"all\":\"All\",\"clear\":\"Clear\",\"invert\":\"Invert\"},\"markersPanel\":{\"heading\":\"Markers\",\"myMarkersHeading\":\"My markers ({count})\",\"myMarkersEmpty\":\"Right-click (long-press on touch) the map to save a pin.\",\"myMarkersEmptyTouch\":\"Long-press the map to save a pin.\",\"myMarkersJump\":\"Go to this pin\",\"myMarkersDelete\":\"Delete pin\",\"myMarkersUnnamed\":\"Pin\",\"otherVersionsPins\":\"{count, plural, one {# pin} other {# pins}} on {version}\",\"otherVersionsDim\":\"{dimension} {count}\",\"otherVersionsCopy\":\"Copy to {version}\",\"otherVersionsMore\":\"{count, plural, one {and # older version} other {and # older versions}}\",\"spawnPoint\":\"Spawn point\",\"slimeChunks\":\"Slime chunks\",\"structuresLabel\":\"Structures (selected: {count})\",\"selectAll\":\"Select all\",\"clear\":\"Clear\",\"reset\":\"Reset\",\"zoomToShow\":\"Zoom to {zoom} to show {name}\",\"zoomToShowSlimeChunks\":\"Zoom to {zoom} to show slime chunks\"},\"biomeChipInput\":{\"placeholder\":\"Select biomes...\",\"disableHighlight\":\"Disable highlight\",\"enableHighlight\":\"Enable highlight\",\"clearAllBiomes\":\"Clear all biomes\",\"moreBiomes\":\"+{count} more\"},\"seo\":{\"about\":{\"heading\":\"What is the Minecraft Seed Map?\",\"paragraph1\":\"The Minecraft Search seed map is a free online viewer that lets you explore any Minecraft world just from its seed. Enter a seed, pick your edition and version, and you can browse biomes, terrain estimation and structures like villages, strongholds, ancient cities, ocean monuments, trial chambers and more – without ever loading the world in game.\",\"paragraph2\":\"It supports both \u003cstrong\u003eJava Edition\u003c/strong\u003e (with optional Large Biomes) and \u003cstrong\u003eBedrock Edition\u003c/strong\u003e, across the \u003cstrong\u003eOverworld\u003c/strong\u003e, the \u003cstrong\u003eNether\u003c/strong\u003e and the \u003cstrong\u003eEnd\u003c/strong\u003e. You can jump between dimensions at the same coordinates, drop custom markers on the map, mark structures as completed, and share a deep link to any view so friends can see exactly what you see.\",\"paragraph3\":\"The seed map is one tool inside \u003clink\u003eMinecraft Search\u003c/link\u003e, a wider Minecraft database covering items, mobs and blocks. Biomes and structures on the map are calculated locally in your browser; if you sign in, your saved seeds and pins sync to your account.\",\"paragraph4\":\"The map also supports the newest releases — \u003cstrong\u003eMinecraft 26.3\u003c/strong\u003e (Java) and \u003cstrong\u003eBedrock 26.60\u003c/strong\u003e — including the new \u003cstrong\u003eSulfur Caves\u003c/strong\u003e cave biome. To find it, choose one of those versions, set the biome height to Underground and highlight Sulfur Caves on the map.\"},\"howToUse\":{\"heading\":\"How to use the Minecraft Seed Map\",\"setupHeading\":\"Setup\",\"setupParagraph\":\"Use the toolbar above the map to enter your \u003cstrong\u003eworld seed\u003c/strong\u003e, then choose the \u003cstrong\u003eedition\u003c/strong\u003e (Java, Large Biomes or Bedrock), the exact \u003cstrong\u003eversion\u003c/strong\u003e, and the \u003cstrong\u003edimension\u003c/strong\u003e (Overworld, Nether or End). You can also load a Java \u003ccode\u003elevel.dat\u003c/code\u003e file to auto-fill the seed and version, or use the random button to generate a new seed. The map updates immediately.\",\"featuresHeading\":\"Features and markers\",\"featuresParagraph\":\"Open the structures strip below the map (or the sidebar in fullscreen) to toggle individual structures like villages, strongholds, ancient cities and ocean monuments. Biome highlighting lets you pick specific biomes and fade out everything else, which is useful when hunting for rare biomes like mushroom fields or cherry groves. Slime chunks and the world spawn can be overlaid on top.\",\"mouseHeading\":\"Mouse controls\",\"mouseDrag\":\"\u003cstrong\u003eDrag\u003c/strong\u003e: pan the map\",\"mouseScroll\":\"\u003cstrong\u003eScroll wheel\u003c/strong\u003e: zoom in and out\",\"mouseClick\":\"\u003cstrong\u003eClick a marker\u003c/strong\u003e: show the structure details popup\",\"mouseRightClick\":\"\u003cstrong\u003eRight-click\u003c/strong\u003e: drop a pin that you can name and save\",\"mouseDoubleClick\":\"\u003cstrong\u003eDouble-click\u003c/strong\u003e: zoom in at that point\",\"keyboardHeading\":\"Keyboard shortcuts\",\"keyboardArrows\":\"\u003cstrong\u003eArrow keys\u003c/strong\u003e: pan the map\",\"keyboardZoom\":\"\u003cstrong\u003e+ / −\u003c/strong\u003e: zoom in and out\",\"keyboardFullscreen\":\"\u003cstrong\u003eF\u003c/strong\u003e: toggle fullscreen map view\",\"keyboardEsc\":\"\u003cstrong\u003eEsc\u003c/strong\u003e: exit fullscreen and close popups\",\"touchHeading\":\"Touch gestures\",\"touchDrag\":\"\u003cstrong\u003eDrag\u003c/strong\u003e: pan the map\",\"touchPinch\":\"\u003cstrong\u003ePinch\u003c/strong\u003e: zoom in and out\",\"touchTap\":\"\u003cstrong\u003eTap a marker\u003c/strong\u003e: show its details\",\"touchHold\":\"\u003cstrong\u003eTap and hold\u003c/strong\u003e: drop a pin\",\"closingParagraph\":\"All your pins, completed structures, enabled features and the current view are saved locally in your browser, so the map opens right where you left off. Share the URL with a friend – the seed, dimension, coordinates and zoom are all encoded in the link.\"},\"faq\":{\"heading\":\"Frequently asked questions\",\"q1\":\"What is a Minecraft seed?\",\"a1\":\"A Minecraft seed is a number or text string used to initialise the world generator. The same seed always produces the same terrain, biomes and structures, so players can share seeds to explore identical worlds.\",\"q2\":\"How do I find the seed of my world?\",\"a2\":\"In single-player, run the command /seed in chat to reveal the seed. On servers you need operator permissions, or access to the savegame files, to read the seed.\",\"q3\":\"Are Java and Bedrock seeds the same?\",\"a3\":\"No. Java Edition and Bedrock Edition use different world-generation algorithms, so the same seed produces completely different worlds in each edition. Always pick the matching edition before generating the map.\",\"q4\":\"How accurate is the Minecraft Seed Map?\",\"a4\":\"Structure markers are verified up to {maxStructurePct}% accurate — villages, strongholds and ocean monuments are the most reliable, and every marker shows its own exact percentage the moment you open it. A few types like dungeons are lower, and some terrain-dependent features are shown as estimates rather than a number. Bedrock figures can be a little lower than Java, because Bedrock places some structures differently even on the same seed.\",\"q5\":\"Why do coastlines not line up with my world?\",\"a5\":\"The map colours are biome colours, not the water level. Terrain inside a land biome often drops below sea level — river valleys, lake basins, flooded lowlands — and is still drawn in its land colour, so a bay or lake in your world can look green here; conversely, ocean and river biomes can contain small patches of land. Terrain estimation adds relief shading that makes those low basins easier to spot; on Java, zoomed in close, it also paints them as water.\",\"q6\":\"Why is the map not loading?\",\"a6\":\"Check that you entered a valid seed with no trailing spaces, and that you picked the edition and version that was used to generate the chunks you are looking at. If the problem persists, try a different browser – the viewer uses modern web features such as WebAssembly and Web Workers.\",\"q7\":\"Can I place and save my own markers?\",\"a7\":\"Yes. Right-click (or tap-and-hold on mobile) on the map to drop a temporary marker, then save it with a name and colour. Markers are stored locally in your browser for the current seed, edition and dimension — and if you sign in with a free account, they also sync across your devices.\",\"q8\":\"Is using the Minecraft Seed Map considered cheating?\",\"a8\":\"That depends on how you play. For single-player exploration or finding specific biomes for a build it is generally fine. On multiplayer servers, check the server rules first – some servers do not allow seed-based tools.\",\"q9\":\"Can I find Sulfur Caves on the seed map?\",\"a9\":\"Yes. Sulfur Caves — the cave biome added in Minecraft 26.2 (Java) and Bedrock 26.30 — can be located on the map. Choose version 26.2 or 26.30, set the biome height to Underground, then highlight Sulfur Caves in the biome list.\",\"q10\":\"What are the Bedrock Edition names for biomes?\",\"a10\":\"Several biomes are named differently in Bedrock Edition — for example Badlands is called Mesa, Windswept Hills is Extreme Hills, Dark Forest is Roofed Forest, Snowy Plains is Ice Plains and Mushroom Fields is Mushroom Island. Select the Bedrock tab on the map and the biome list and labels switch to Bedrock names automatically; the biome search box also accepts either edition's name. The full Java-to-Bedrock biome name list is shown above.\",\"q11\":\"Do my saved seeds and markers sync across devices?\",\"a11\":\"By default everything is saved locally in your browser only. Create a free account and sign in, and your saved seeds, custom markers and completion check-offs sync automatically to every device you use — the seed map itself works exactly the same with or without an account.\",\"q12\":\"Why does the map show a structure that isn't in my world — and how do I fix it?\",\"a12\":\"Almost always it is a version or edition mismatch. Java and Bedrock generate completely different worlds from the same seed, and even within one edition the structure layout changes across major updates. Check that the edition and the exact version selected above the map match the world you are playing, then regenerate. Some markers are chunk-centre approximations, so the real structure can sit a few blocks from the marker; and on rare occasions a marker fails to render, which reloading the page fixes.\",\"q13\":\"How do I draw a world border on the map?\",\"a13\":\"Open the seed map's Advanced settings (the gear icon) and switch on the world border, then set the center point and radius. The map draws the playable area as a square — matching Java Edition's /worldborder — or a circle, with a live block-size readout that follows pan and zoom. A copy button gives you the exact /worldborder center and /worldborder set commands to recreate the same border in your world. Bedrock Edition has no vanilla /worldborder command, so there the border is shown for planning only.\",\"q14\":\"Can I install the seed map as an app?\",\"a14\":\"Yes. You can install the seed map to your home screen as a Progressive Web App (PWA), straight from your browser and with no app store needed. On Android or desktop Chrome, use the Install app button (or your browser's install icon) to add it; on iPhone or iPad, open Safari's Share menu and choose Add to Home Screen. It then opens full-screen like a native app — but it is a web app, so there is no separate store download.\",\"q15\":\"Does the seed decide what my enchanting table offers?\",\"a15\":\"No — the world seed has nothing to do with it. Enchanting table offers come from your character's own enchantment seed, which re-rolls every time you enchant something. Two players on the same world see different offers, and the same player sees new ones after every enchant. What the seed cannot change is the set of enchantments the table is allowed to offer and how likely each one is — that depends only on the item and your bookshelf count.\"},\"biomeNames\":{\"heading\":\"Biome names in Java vs Bedrock Edition\",\"intro\":\"Minecraft names several biomes differently in Bedrock Edition. Pick the Bedrock tab on the map above and the biome list switches to Bedrock names automatically; the biome search box matches either edition's name. Here is the full mapping.\",\"javaColumn\":\"Java Edition\",\"bedrockColumn\":\"Bedrock Edition\"},\"oreFinderFaq\":{\"heading\":\"Minecraft Ore Finder – frequently asked questions\",\"q1\":\"How does the Minecraft Ore Finder work?\",\"a1\":\"The Ore Finder reproduces Minecraft's own ore-placement maths from your world seed, entirely in your browser. It runs the same ore-distribution and cave-carving steps the game uses, then marks the chunks where diamonds, netherite and other ores are most likely to be exposed. If you sign in, your saved seeds and pins sync to your account.\",\"q2\":\"Why isn't the Ore Finder 100% accurate?\",\"a2\":\"Where an ore ends up depends on the exact terrain and caves Minecraft carves around it, and no in-browser tool can rebuild every block the game places. We reproduce that terrain very closely, so a hotspot marked with a high percentage really contains the ore in your world around {minOrePct}–{maxOrePct}% of the time on Java, and {minOreBedrockPct}–{maxOreBedrockPct}% on Bedrock — the per-ore figure for the edition you picked is on the badge and in the table above. A few spots may have been carved away by a cave or shifted slightly, so treat the markers as very strong leads rather than a guarantee.\",\"q3\":\"Which ores can the finder locate?\",\"a3\":\"In the Overworld it finds diamond, iron, copper, gold, redstone, lapis lazuli and coal, and in the Nether it finds ancient debris (netherite). You search one ore at a time and can optionally limit the search to a specific Y level.\",\"q4\":\"What is the best Y level to mine diamonds?\",\"a4\":\"Diamonds get more common the deeper you dig, peaking around Y -59 in current versions (they generate between Y -64 and Y 16). The finder defaults to each ore's full spawn range, and you can tick 'limit to a specific Y level' to focus on the richest band – for diamonds, around Y -59 to -54.\",\"q5\":\"Does the Ore Finder work for my Minecraft version?\",\"a5\":\"It works on both Java and Bedrock Edition. On Java it covers modern versions, including 1.21 and the 26.x releases, which share the same ore-generation rules. Bedrock Edition is now supported as well – on 1.18 and newer it finds the Overworld ores (diamond, iron, copper, gold, redstone and lapis lazuli). The two editions use different world generators, so make sure you pick the edition your world was created in.\",\"q6\":\"Is using the Ore Finder cheating?\",\"a6\":\"That is up to how you like to play. In single-player it is just a faster version of strip-mining for a diamond start. On multiplayer servers, check the rules first – some servers don't allow seed-based tools.\"},\"troubleshooting\":{\"heading\":\"Troubleshooting\",\"intro\":\"If the map does not match your in-game world, the cause is almost always one of these:\",\"seedHeading\":\"Wrong seed or coordinates\",\"seedParagraph\":\"Double-check that the seed is typed exactly as in-game, with no leading or trailing spaces. Seeds are case-sensitive only when entered as text – numeric seeds must match exactly.\",\"versionHeading\":\"Edition or version mismatch\",\"versionParagraph\":\"Java Edition and Bedrock Edition generate completely different worlds for the same seed. Within a single edition, different Minecraft versions can also produce noticeably different terrain – especially across the major 1.13, 1.15 and 1.18 world-gen overhauls. Pick the edition and version that was used to generate the chunks you are looking at.\",\"modsHeading\":\"Mods, datapacks or world presets\",\"modsParagraph\":\"Mods, behaviour packs, datapacks and custom world presets can all change world generation. If your world uses any of these, the map may no longer be accurate for the modified areas.\",\"coastlinesHeading\":\"Coastlines and terrain vs. biomes\",\"coastlinesParagraph\":\"From version 1.18 onwards, coastlines do not match biome boundaries exactly. The seed map shows the underlying biomes, not the water level, so terrain that drops below sea level inside a land biome still appears in its land colour — a bay or lake can show up green. The opposite case, water colour over dry land, is rare. The terrain option shades the relief so those low areas stand out; on Java, zoomed in close, it also paints them as water.\",\"yCoordsHeading\":\"Missing Y coordinates\",\"yCoordsParagraph\":\"Some features such as mineshafts, strongholds and nether fortresses extend vertically, so a Y coordinate is only shown when it is meaningful. For buried structures, search at different heights at the given X/Z.\",\"slimeHeading\":\"Slime chunks show no slimes in-game\",\"slimeParagraph\":\"Slime chunks have a very low natural spawn rate. You may need to wait several minutes in a large, fully lit area, and make sure there are no other hostile mob spawns nearby competing for the mob cap.\"},\"credits\":{\"heading\":\"Credits\",\"intro\":\"The Minecraft Search seed map is built on top of outstanding open-source work by the wider Minecraft and web-tooling community. Huge thanks to the authors of the following projects:\",\"cubiomes\":\"Java Edition biome and structure generation, by Cubitect and contributors.\",\"cubiomesBedrock\":\"Bedrock 1.16 and 1.17 biomes and Bedrock Nether generation, by Reed A. Cartwright.\",\"bedrockified\":\"Bedrock structure algorithms, by Earthcomputer.\",\"mcbeStructureFinder\":\"Additional Bedrock structure generation logic, by xiaohengying.\",\"amidst\":\"Biome colour palette reference.\",\"openlayers\":\"The map rendering engine.\",\"disclaimer\":\"Minecraft Search is not affiliated with Mojang Studios or Microsoft. Minecraft is a trademark of Mojang Studios.\",\"licenseTexts\":\"Open-source license texts\"}},\"errors\":{\"errorPrefix\":\"Error:\",\"dismissError\":\"Dismiss error\",\"rendererCrashed\":\"The map renderer hit an unexpected error.\",\"rendererFailedToLoad\":\"The map engine couldn't start. This usually means the site was updated after this page was opened, or the connection dropped while the map was loading.\",\"webglInitFailed\":\"The map couldn't initialize your device's graphics (WebGL). This can happen when too many tabs or apps are using the GPU.\",\"renderTimeout\":\"The map is taking longer than expected to load.\",\"reloadPage\":\"Reload page\",\"browserUnsupported\":\"This browser can't run the interactive map. Please update your browser, or open this page in a recent version of Chrome, Edge, Firefox, or Safari.\"},\"notices\":{\"finderUnsupported\":\"Some structure markers need a newer browser version.\",\"dismiss\":\"Dismiss\",\"strongholdRingLimit\":\"Strongholds only generate within about {distance, number} blocks of 0, 0.\",\"nothingToReveal\":\"{feature} — none close enough to show\"},\"misc\":{\"openSettings\":\"Open settings\",\"bedrockAttribution\":\"Bedrock 1.16 and 1.17 biomes and Bedrock Nether are calculated using a cubiomes fork by Reed A. Cartwright.\",\"loadingMap\":\"Loading the map…\",\"skipToTool\":\"Skip to the tool\",\"loadingMarkers\":\"Loading markers…\",\"fullscreenTitle\":\"Fullscreen\",\"exitFullscreenTitle\":\"Exit fullscreen (Esc)\",\"debugOverlayTitle\":\"Debug Overlay (F1 to toggle)\",\"debugCheckConsole\":\"Check console for detailed stats\",\"debugPanZoom\":\"Pan/zoom to see real-time metrics\",\"debugPerformanceActive\":\"Performance counters active\",\"downloadingEngine\":\"Downloading the map engine…\",\"downloadingEngineMb\":\"Downloading the map engine… {mb} MB\",\"startingMap\":\"Starting the map…\",\"closePopup\":\"Close\",\"biomeMapAria\":\"{biome} seed map\"},\"feedback\":{\"locationCopied\":\"Location copied!\",\"shareLinkCopied\":\"Share link copied!\"},\"structureGroups\":{\"bastionRemnant\":\"Bastion Remnant\",\"netherFossil\":\"Nether Fossil\",\"lavaPool\":\"Lava Pool\",\"ravine\":\"Ravine\",\"igloo\":\"Igloo\",\"fossil\":\"Fossil\"},\"structures\":{\"village\":\"Village\",\"ocean_monument\":\"Ocean Monument\",\"shipwreck\":\"Shipwreck\",\"mineshaft\":\"Mineshaft\",\"ancient_city\":\"Ancient City\",\"amethyst_geode\":\"Amethyst Geode\",\"woodland_mansion\":\"Woodland Mansion\",\"desert_pyramid\":\"Desert Pyramid\",\"jungle_temple\":\"Jungle Temple\",\"igloo_no_basement\":\"Igloo\",\"igloo_with_basement\":\"Igloo (Basement)\",\"pillager_outpost\":\"Pillager Outpost\",\"ruined_portal\":\"Ruined Portal\",\"buried_treasure\":\"Buried Treasure\",\"swamp_hut\":\"Swamp Hut\",\"stronghold\":\"Stronghold\",\"ocean_ruin\":\"Ocean Ruin\",\"desert_well\":\"Desert Well\",\"trail_ruin\":\"Trail Ruin\",\"trial_chambers\":\"Trial Chambers\",\"sulfur_spring\":\"Sulfur Spring\",\"abandoned_camp\":\"Abandoned Camp\",\"nether_fortress\":\"Nether Fortress\",\"bastion_remnant_bridge\":\"Bastion (Bridge)\",\"bastion_remnant_hoglin_stable\":\"Bastion (Hoglin Stable)\",\"bastion_remnant_housing_units\":\"Bastion (Housing Units)\",\"bastion_remnant_treasure_room\":\"Bastion (Treasure Room)\",\"ruined_portal_nether\":\"Ruined Portal\",\"end_city\":\"End City\",\"end_gateway\":\"End Gateway\",\"dungeon_zombie\":\"Dungeon (Zombie)\",\"dungeon_skeleton\":\"Dungeon (Skeleton)\",\"dungeon_spider\":\"Dungeon (Spider)\",\"nether_fossil\":\"Nether Fossil\",\"nether_fossil_ghast\":\"Nether Fossil (Dried Ghast)\",\"underground_lava_lake\":\"Lava Pool\",\"lava_flooded_cave\":\"Lava-Flooded Cave\",\"cheese_cave\":\"Cheese Cave\",\"ravine\":\"Ravine\",\"mega_ravine\":\"Mega Ravine\",\"underwater_ravine\":\"Underwater Ravine\",\"mega_underwater_ravine\":\"Mega Underwater Ravine\",\"iron_vein\":\"Iron Vein\",\"copper_vein\":\"Copper Vein\",\"enchanted_golden_apple\":\"Enchanted Golden Apple (Desert Pyramid)\",\"fossil\":\"Fossil\",\"fossil_diamond\":\"Diamond Fossil\"},\"structureVariants\":{\"sizeSmall\":\"Small\",\"sizeMedium\":\"Medium\",\"sizeLarge\":\"Large\",\"oreVein\":\"{name} ({size})\",\"villageAbandoned\":\"Zombie {name}\",\"abandonedCamp\":\"{name} ({biome})\",\"endCityShip\":\"End City (Ship)\",\"endCityNoShip\":\"End City (No Ship)\",\"enchantedAppleTempleChest\":\"Enchanted Apple (Temple Chest)\",\"oceanRuinSmallCold\":\"Small, Cold Ruin\",\"oceanRuinSmallWarm\":\"Small, Warm Ruin\",\"oceanRuinLargeCold\":\"Large, Cold Ruin\",\"oceanRuinLargeWarm\":\"Large, Warm Ruin\",\"oceanRuinClusterSmallCold\":\"Small, Cold Ruin with Cluster ({count} small ruins)\",\"oceanRuinClusterSmallWarm\":\"Small, Warm Ruin with Cluster ({count} small ruins)\",\"oceanRuinClusterLargeCold\":\"Large, Cold Ruin with Cluster ({count} small ruins)\",\"oceanRuinClusterLargeWarm\":\"Large, Warm Ruin with Cluster ({count} small ruins)\",\"ruinedPortalBurial\":\"{burial} {name}\",\"burialUnderwater\":\"Underwater\"},\"miniViewer\":{\"openInFullViewer\":\"Open in full viewer →\",\"likelyLabel\":\"Likely {name}\"},\"finderCta\":{\"heading\":\"{name} Finder\",\"body\":\"Find every {name} on any seed with the interactive map — exact coordinates, no guessing.\",\"button\":\"Open the Seed Map →\"},\"finderFaqHeading\":\"{name}: Frequently Asked Questions\",\"olControls\":{\"zoomIn\":\"Zoom in\",\"zoomOut\":\"Zoom out\",\"resetRotation\":\"Reset rotation\",\"attributions\":\"Attributions\"},\"oreFinder\":{\"landing\":{\"shared\":{\"answerLabel\":\"Quick answer\",\"diamondGateLabel\":\"Free or Supporter\",\"diamondGate\":\"Every ore finder here is free with no sign-up, except diamonds: the Diamond Finder needs a Supporter plan, from {price} a month. Try it first — one free scan shows the {count} diamond clusters nearest a spot you pick.\",\"diamondGateCn\":\"Every ore finder here is free with no sign-up, except diamonds: the Diamond Finder needs a Supporter plan, from {price}. Try it first — one free scan shows the {count} diamond clusters nearest a spot you pick.\",\"diamondGateLink\":\"See Supporter plans\",\"accuracyBadgeLabel\":\"Finder accuracy\",\"accuracyBadgeUpTo\":\"up to {maxPct}%\",\"openFullViewer\":\"Open in the full seed map\",\"allFinders\":\"All ore finders\",\"findOnMap\":\"Find {ore} on the map\",\"catalogHeading\":\"Full {ore} reference\",\"catalogIntro\":\"Y-levels, drop rates, smelting and recipes for {ore} — straight from our Minecraft catalog, in both editions.\",\"specHeading\":\"Best Y level \u0026 finder accuracy\",\"colOre\":\"Ore\",\"colBestY\":\"Best Y level\",\"colRange\":\"Spawn range\",\"colJava\":\"Java accuracy\",\"colBedrock\":\"Bedrock accuracy\",\"howHeading\":\"How the ore finder works\",\"howStep1\":\"Enter your world seed and pick your edition (Java or Bedrock) and version — the map redraws your exact world.\",\"howStep2\":\"Pick an ore from the rail above the map — its hotspots appear automatically on your world, with no button to press.\",\"howStep3\":\"Pan or zoom and fresh hotspots keep spawning. Click any one for its exact X / Y / Z, then dig there — the accuracy badge shows how often a marked spot really holds the ore.\",\"editions\":\"Java 26.3 · Bedrock 1.26.60 · both editions\",\"accuracyNote\":\"Accuracy is the share of marked hotspots that really contain the ore in your world, shown as a plain number.\",\"na\":\"—\",\"relatedHeading\":\"More Minecraft finders\",\"oreFinderName\":\"{ore} finder\",\"structureFinder\":\"Structure finder\",\"biomeFinder\":\"Biome finder\",\"alsoCalled\":\"Also called\",\"colVersion\":\"Version\",\"colJavaEdition\":\"Java\",\"colBedrockEdition\":\"Bedrock\",\"colEdition\":\"Edition\",\"colEditions\":\"Editions\",\"versionRange\":\"{from} – {to}\",\"versionCurrent\":\"{from} – {to} (current)\",\"versionUnchanged\":\"Unchanged since {version}\",\"editionNotOffered\":\"Not offered on Bedrock\",\"veinHeading\":\"{ore} veins on Java and Bedrock\",\"colVein\":\"Vein\",\"colHowOften\":\"How often\",\"colVeinSize\":\"Vein size\",\"colWhere\":\"Where\",\"colAir\":\"Blocks touching air\",\"veinBoth\":\"Java and Bedrock\",\"veinPerChunk\":\"{n} per chunk\",\"veinOneIn\":\"1 chunk in {n}\",\"veinEven\":\"{range}, evenly spread\",\"veinPeak\":\"{range}, most near {peak}\",\"veinAirKept\":\"Placed anyway\",\"veinAirNever\":\"Always skipped\",\"veinAirSome\":\"{n} in 10 skipped\",\"veinCaption\":\"The game's own ore settings on Java 26.3 and Bedrock 1.26.60. A vein skips some of its blocks where they would touch air, so caves show less of it than solid rock holds.\",\"veinCaptionSettings\":\"The game's own ore settings on Java 26.3 and Bedrock 1.26.60.\",\"vein\":{\"small\":\"Small veins\",\"medium\":\"Deep extra veins\",\"large\":\"Large veins\",\"buried\":\"Buried veins\",\"middle\":\"Mid-depth veins\"}},\"hub\":{\"h1\":\"Minecraft Ore Finder — Diamonds, Ancient Debris, Iron \u0026 More on a Visual Map (Java + Bedrock)\",\"tldr\":\"Enter your seed and this Ore Finder marks where diamonds, ancient debris (netherite) and other ores spawn — on a visual map, not a flat list, at up to {maxPct}% accuracy across Minecraft Java 26.3 and Bedrock 1.26.60.\",\"intro\":\"Most ore finders give you a plain coordinate list for one edition. Ours draws every hotspot on an interactive map of your actual world, badges each ore with its measured accuracy, works on Java and Bedrock, and links straight to the catalog for Y-levels and drop rates.\",\"gridHeading\":\"Pick an ore to find\",\"gridSubtitle\":\"Jump straight to a finder — visual map, exact Y-levels and per-edition accuracy for Java \u0026 Bedrock.\",\"h2a\":\"What is the best Y level for each ore?\",\"a2a\":\"Diamonds and redstone are most common at Y −59, ancient debris (netherite) peaks at Y 15, gold around Y −16, copper at Y 48, iron at Y 16, lapis near Y 0 and coal up around Y 96. The table below lists every ore's best level and full spawn range.\",\"h2b\":\"Does the ore finder work for Java and Bedrock?\",\"a2b\":\"Yes. The finder reproduces ore generation from your seed for both editions — Java 26.3 and Bedrock 1.26.60 — and the spec table below lists every ore's Java and Bedrock accuracy figures. The two editions generate worlds differently, so pick the edition your world was made in.\",\"h2c\":\"Is there an ore finder for Minecraft Bedrock?\",\"a2c\":\"Yes — seven of the eight ores on this page work on Bedrock as well as Java: diamond, ancient debris, iron, gold, copper, redstone and lapis. Coal is the exception and is Java-only. Switch the edition on any finder and the map rebuilds your Bedrock world from the same seed; the table above carries both editions’ accuracy side by side, and on gold the Bedrock figure is the higher one.\",\"h2d\":\"What is an ore tracker?\",\"a2d\":\"An ore tracker — also called an ore locator or ore finder — works out where ore veins generate in your world from the seed alone, before you dig. This one draws them on a map of your actual world instead of printing a list of coordinates, covers Java and Bedrock, and shows each ore’s measured accuracy so you know how far to trust a marker.\"},\"diamond\":{\"h1\":\"Minecraft Diamond Finder — Best Y Level \u0026 Where to Find Diamonds (Java + Bedrock 26.3)\",\"tldr\":\"Diamonds are most common at Y −59 (deepslate band Y −64 to −48; they spawn from Y 16 down to Y −64). This Diamond Finder marks diamond hotspots from your seed on a visual map at {javaPct}% accuracy on Java 26.3 and {bedrockPct}% on Bedrock 1.26.60.\",\"h2a\":\"Where do diamonds spawn in Minecraft?\",\"a2a\":\"Diamonds spawn from Y 16 down to the world floor at Y −64, and get steadily more common the deeper you go. They generate inside deepslate below Y 0, which is why the richest mining is in the deepslate band. Enter your seed above and the finder marks the exact chunks where diamonds are most likely exposed.\",\"h2b\":\"What is the best Y level for diamonds?\",\"a2b\":\"The best Y level for diamonds is Y −59. Diamond density increases toward the bottom of the world and peaks in the Y −64 to −48 band, with Y −59 the single richest level in current versions. Mine long branches at Y −59 (or −58) for the best return.\",\"h2c\":\"Best Y level for diamonds in Bedrock?\",\"a2c\":\"Bedrock Edition uses the same Y −64 to 16 range and the same Y −59 sweet spot as Java, with one real difference: the two extra deep veins each chunk gets below Y −4 are smaller on Bedrock — vein size {bedrockDeepVein}, against {javaDeepVein} on Java. The table above compares every kind of diamond vein on both editions. The finder supports Bedrock 1.26.60 at {bedrockPct}% accuracy — the badge by the page title shows both editions' figures.\",\"h2d\":\"What Y level are diamonds in Minecraft 1.21?\",\"a2d\":\"{bestY} — the same level as on every version from {javaFrom} on. Diamonds generate across {range} on Java {javaFrom} through {javaTo} and Bedrock {bedrockFrom} through {bedrockTo} alike, and neither the best level nor the range has moved. Java {javaFork} and Bedrock {bedrockFork} each added another diamond placement rule inside that band: more diamonds, same layer to stand on. The table above lists both editions.\",\"h2e\":\"How deep should you dig for diamonds?\",\"a2e\":\"Dig to {bestY} and tunnel sideways from there. That is the deepest level you can actually stand in — the world floor is Y −64 and bedrock fills in unevenly up to about Y −60, so {bestY} is the last clear layer. The whole Y −64 to −48 band is rich, so a branch mine one or two blocks either side of {bestY} loses almost nothing; going lower only buys you bedrock.\",\"h2f\":\"Can you find diamonds in trial chambers?\",\"a2f\":\"Yes — a trial chamber vault holds diamonds {vaultPct} of the time and an ominous vault {ominousVaultPct} of the time, on top of the diamond blocks, axes and pickaxes in the chamber’s chests and barrels. Trial chambers generate down in the deepslate layer, so one is often already on your way to {bestY}.\",\"linkTrialChamberFinder\":\"Find trial chambers in your seed\",\"h2g\":\"How do you find a diamond in Minecraft?\",\"a2g\":\"Take an iron pickaxe or better down to {bestY}, then branch-mine or follow a deepslate cave — most first diamonds are spotted in cave and ravine walls below Y 0 rather than dug blind. Enter your seed above and the finder marks where diamond veins generate in your world, so you pick a direction instead of guessing.\",\"linkDiamondGuide\":\"How to find diamonds in Minecraft — the full guide\"},\"ancientDebris\":{\"h1\":\"Minecraft Ancient Debris Finder — Netherite Y Level \u0026 Where to Find It (Java + Bedrock)\",\"tldr\":\"Ancient debris (the source of netherite) peaks at Y 15 and generates between Y 8 and Y 119, densest from Y 8 to 24. This Netherite Finder marks ancient debris from your seed on a visual map at {javaPct}% accuracy on Java 26.3 and {bedrockPct}% on Bedrock 1.26.60.\",\"h2a\":\"What Y level is ancient debris / netherite?\",\"a2a\":\"Ancient debris is most common at Y 15. It generates throughout the Nether from Y 8 up to Y 119, but the dense band is Y 8 to 24 — so the netherite level players mine at is Y 15 (sometimes Y 14–16 to clear a 2-block-tall tunnel). Netherite itself is crafted from the scrap you smelt from ancient debris.\",\"h2b\":\"Where does ancient debris spawn?\",\"a2b\":\"Ancient debris spawns anywhere in the Nether, buried inside netherrack, basalt and blackstone — it is never exposed to air, so you have to dig or blast to it. It is blast-resistant, so bed or TNT mining at Y 15 is a common tactic. The finder marks the chunks most likely to hold a vein so you don't blast blind.\",\"h2c\":\"Best Y level for netherite in Bedrock?\",\"a2c\":\"Y 15 works on Bedrock too, for a slightly different reason. Java bunches its deep debris around the middle of the Y 8 to 24 band; Bedrock spreads its deep debris evenly between about Y 8 and 23, so no level beats another there, and Y 15 sits in the middle of both. The tunnel plan is the same on either edition. The finder supports Bedrock 1.26.60 at {bedrockPct}% accuracy — the badge by the page title shows both editions' figures.\",\"h2d\":\"Has the ancient debris Y level changed in any version?\",\"a2d\":\"No — not in any version this finder covers. Ancient debris generates across {range} with its dense band at Y 8 to 24 on Java {javaFrom} through {javaTo} and Bedrock {bedrockFrom} through {bedrockTo}, and {bestY} has been the level to tunnel at throughout. The debris generator is version-independent on both editions: across that whole span the same seed puts the same debris in the same place.\",\"h2e\":\"Is there an ancient debris finder for Bedrock?\",\"a2e\":\"Yes — switch the edition above and the finder marks ancient debris on Bedrock {bedrockFrom} through {bedrockTo} at {bedrockPct}% accuracy, against {javaPct}% on Java. Both editions share the {range} range and the {bestY} sweet spot, so the tunnel plan is identical; only the vein positions differ, because the two editions build the Nether from your seed differently.\"},\"iron\":{\"h1\":\"Minecraft Iron Finder — Best Y Level \u0026 Where to Find Iron (Java + Bedrock 26.3)\",\"tldr\":\"Iron is most common at Y 16 (and again near mountain peaks); it spawns from Y 320 down to Y −64. This Iron Finder marks iron ore from your seed on a visual map at {javaPct}% accuracy on Java 26.3 and {bedrockPct}% on Bedrock 1.26.60.\",\"h2a\":\"Where does iron spawn in Minecraft?\",\"a2a\":\"Iron generates almost everywhere from Y 320 down to Y −64, in two ways: small ore blobs at every level, plus large iron veins inside mountain and badlands biomes. Density is highest around Y 16 and again high up in the mountains. Enter your seed and the finder marks the chunks where iron is most likely exposed.\",\"h2b\":\"What is the best Y level for iron?\",\"a2b\":\"The best Y level for iron is Y 16 for underground branch mining — the low-altitude peak of its spawn curve. In mountain biomes the upper slopes (around Y 128–232) hold huge iron veins, so mining an exposed mountainside there can be even faster.\",\"h2c\":\"Best Y level for iron in Bedrock?\",\"a2c\":\"Y 16 on Bedrock too: the mid-depth iron veins peak there on both editions. The table above compares the two kinds of underground iron vein on Java and Bedrock side by side. Both editions also grow a third kind high inside mountains, from Y 80 up, which the table leaves out. The finder supports Bedrock 1.26.60 at {bedrockPct}% accuracy — the badge by the page title shows both editions' figures.\",\"h2d\":\"What are giant iron veins and where do they generate?\",\"a2d\":\"Giant iron veins generate at {veinBand} — tuff-and-ore formations far larger than the ordinary iron blobs that peak at {bestY}, with blocks of raw iron scattered through them. Both Java and Bedrock generate them, from the same seed, and the full seed map draws them as their own layer. One vein can run for dozens of blocks, so reaching one beats a long branch mine.\",\"linkVeinLayer\":\"Show giant veins on the full seed map\"},\"gold\":{\"h1\":\"Minecraft Gold Finder — Best Y Level \u0026 Where to Find Gold (Java + Bedrock 26.3)\",\"tldr\":\"Gold is most common at Y −16 and spawns from Y 32 down to Y −64, with extra gold throughout badlands biomes. This Gold Finder marks gold ore from your seed on a visual map at {javaPct}% accuracy on Java 26.3 and {bedrockPct}% on Bedrock 1.26.60.\",\"h2a\":\"Where does gold spawn in Minecraft?\",\"a2a\":\"Gold ore generates from Y 32 down to the world floor at Y −64, getting more common the deeper you go and peaking around Y −16. Badlands (mesa) biomes get a big bonus: extra gold spawns there at almost every height, even near the surface. The finder marks the chunks most likely to hold a vein.\",\"h2b\":\"What is the best Y level for gold?\",\"a2b\":\"The best Y level for gold is Y −16. Density rises toward the deepslate layers and peaks in the −16 band, so branch mining around Y −16 (down to about Y −48) gives the best return — unless you are in a badlands biome, where surface gold mining is faster.\",\"h2c\":\"Best Y level for gold in Bedrock?\",\"a2c\":\"Bedrock uses the same Y range and Y −16 sweet spot as Java, and the badlands bonus too. The finder supports Bedrock 1.26.60 at {bedrockPct}% accuracy — the badge by the page title shows both editions' figures.\",\"h2d\":\"What Y level is gold in Minecraft 1.21?\",\"a2d\":\"{bestY}, on Java 1.21 and Bedrock 1.21 alike — and on every version from {javaFrom} onward, because gold’s range ({range}) and its peak have not moved. What changes is where you stand rather than which version you are on: badlands biomes generate extra gold at almost any height, so surface mining a mesa can out-earn a branch mine at {bestY}.\"},\"redstone\":{\"h1\":\"Minecraft Redstone Finder — Best Y Level \u0026 Where to Find Redstone (Java + Bedrock 26.3)\",\"tldr\":\"Redstone ore is most common at Y −59 (deepslate band Y −64 to −48) and spawns from Y 15 down to Y −64. This Redstone Finder marks redstone ore from your seed on a visual map at {javaPct}% accuracy on Java 26.3 and {bedrockPct}% on Bedrock 1.26.60.\",\"h2a\":\"Where does redstone spawn in Minecraft?\",\"a2a\":\"Redstone generates from Y 15 down to the world floor at Y −64 and becomes far more common toward the bottom — almost all of it sits in the deepslate layers below Y 0. It follows the same depth curve as diamond, so the deepest levels are the richest. The finder marks the chunks most likely to expose a vein.\",\"h2b\":\"What is the best Y level for redstone?\",\"a2b\":\"The best Y level for redstone is Y −59, the same sweet spot as diamond. Redstone density peaks in the Y −64 to −48 band, so long branch tunnels at Y −59 (or −58) collect the most — and you will often turn up diamonds on the same trips.\",\"h2c\":\"Best Y level for redstone in Bedrock?\",\"a2c\":\"Bedrock uses the same Y −64 to 15 range and Y −59 sweet spot as Java. The finder supports Bedrock 1.26.60 at {bedrockPct}% accuracy — the badge by the page title shows both editions' figures.\",\"h2d\":\"Has the redstone Y level changed in any recent version?\",\"a2d\":\"No — {bestY} has been the peak, and {range} the range, on Java {javaFrom} through {javaTo} and Bedrock {bedrockFrom} through {bedrockTo}. Note where the range stops: redstone tops out at Y 15, one level below diamond’s Y 16 — a one-level difference that is easy to miss. Below Y 0 the two follow the same curve, so a branch mine at {bestY} collects both.\"},\"copper\":{\"h1\":\"Minecraft Copper Finder — Best Y Level \u0026 Where to Find Copper (Java + Bedrock 26.3)\",\"tldr\":\"Copper is most common at Y 48 and spawns from Y 112 down to Y −16, with the biggest veins in dripstone caves. This Copper Finder marks copper ore from your seed on a visual map at {javaPct}% accuracy on Java 26.3 and {bedrockPct}% on Bedrock 1.26.60.\",\"h2a\":\"Where does copper spawn in Minecraft?\",\"a2a\":\"Copper ore generates from Y 112 down to Y −16, peaking around Y 48. Dripstone caves get much larger copper veins, so a dripstone cave near Y 48 is the fastest place to mine it. The finder marks the chunks most likely to hold a vein on a map of your world.\",\"h2b\":\"What is the best Y level for copper?\",\"a2b\":\"The best Y level for copper is Y 48 — the centre of its spawn range and where ordinary veins are densest. For the giant veins, look for dripstone caves around the same height and mine outward from Y 48 for the best yield.\",\"h2c\":\"Best Y level for copper in Bedrock?\",\"a2c\":\"Bedrock uses the same Y range and Y 48 sweet spot as Java. The finder supports Bedrock 1.26.60 at {bedrockPct}% accuracy — the badge by the page title shows both editions' figures.\",\"h2d\":\"Where do giant copper veins generate?\",\"a2d\":\"Giant copper veins generate at {veinBand}, overlapping the {bestY} band where ordinary copper is densest — granite-filled formations many times the size of a normal copper blob, with blocks of raw copper inside. Both Java and Bedrock generate them from the same seed, and the full seed map draws them as their own layer. When you need copper by the shulker box rather than by the stack, that layer is the thing to aim at.\",\"linkVeinLayer\":\"Show giant veins on the full seed map\"},\"lapis\":{\"h1\":\"Minecraft Lapis Finder — Best Y Level \u0026 Where to Find Lapis Lazuli (Java + Bedrock 26.3)\",\"tldr\":\"Lapis lazuli is most common at Y 0 and spawns from Y 64 down to Y −64. This Lapis Finder marks lapis ore from your seed on a visual map at {javaPct}% accuracy on Java 26.3 and {bedrockPct}% on Bedrock 1.26.60.\",\"h2a\":\"Where does lapis lazuli spawn in Minecraft?\",\"a2a\":\"Lapis spawns in two overlapping ways: a band centred on Y 0 that thins out above and below it, plus a buried batch spread evenly from the bottom of the world up to Y 64 in Java Edition. The combined sweet spot is around Y 0, near where stone meets deepslate. The finder marks the chunks most likely to hold a vein.\",\"h2b\":\"What is the best Y level for lapis?\",\"a2b\":\"The best Y level for lapis lazuli is Y 0. The main lapis batch peaks right around the stone/deepslate boundary, so branch mining between about Y −5 and Y 5 collects the most. You will find lapis at other depths too, just less often.\",\"h2c\":\"Best Y level for lapis in Bedrock?\",\"a2c\":\"Bedrock uses the same Y range and Y 0 sweet spot as Java. The finder supports Bedrock 1.26.60 at {bedrockPct}% accuracy — the badge by the page title shows both editions' figures.\",\"h2d\":\"What Y level is lapis lazuli in 1.21 and on Bedrock?\",\"a2d\":\"{bestY} on both — Java 1.21 and Bedrock 1.21 put the lapis peak at the stone-to-deepslate boundary, and no version from {javaFrom} onward has moved it. Lapis is centred rather than bottom-heavy, unlike diamond and redstone: its range ({range}) peaks in the middle, and below about Y −32 only its thinner second batch is still generating — so digging on past the diamond levels finds you less lapis, not more.\"},\"coal\":{\"h1\":\"Minecraft Coal Finder — Best Y Level \u0026 Where to Find Coal (Java 26.3)\",\"tldr\":\"Coal is the most common ore in Minecraft, spawning from Y 320 down to Y 0 and peaking around Y 96 — especially across mountains. This Coal Finder marks coal ore from your seed on a visual map at {javaPct}% accuracy on Java 26.3.\",\"h2a\":\"Where does coal spawn in Minecraft?\",\"a2a\":\"Coal generates throughout the upper world from Y 320 down to Y 0 and is the most abundant ore in the game. It is densest at higher altitudes — exposed mountainsides are covered in it — and tapers off below sea level. The finder marks the chunks most likely to expose a coal vein on a map of your world.\",\"h2b\":\"What is the best Y level for coal?\",\"a2b\":\"The best Y level for coal is around Y 96, and higher still in mountain biomes where huge coal veins generate near the surface. Because coal is so common you rarely need to mine for it specifically — but when you do, the upper Y levels and mountain slopes are fastest.\",\"h2c\":\"Is a coal finder worth using?\",\"a2c\":\"Coal is common enough that most players pick it up while mining for other ores, but a coal finder is handy for an early-game fuel run or for hunting the big mountain veins. Set your seed above and the map marks the richest nearby coal chunks.\",\"h2d\":\"What Y level is coal in Minecraft 1.21?\",\"a2d\":\"Around {bestY}, unchanged on every version from {javaFrom} to {javaTo}. Coal spans {range}, and it is the only Overworld ore here that never generates below Y 0 — the deepslate levels everyone branch-mines for diamonds hold no coal at all. Its second concentration sits high up, which is why exposed mountainsides are covered in it. If you are already mining deep for diamonds, coal is the one ore not worth a special trip.\"}},\"title\":\"Ore Finder\",\"diamonds\":\"diamonds\",\"netherite\":\"netherite\",\"scan\":\"Scan {ore}\",\"scanning\":\"Scanning {ore}… {percent}%\",\"hotspots\":\"{count} hotspots — rescan\",\"popupDiamond\":\"Diamond hotspot\",\"popupNetherite\":\"Netherite hotspot\",\"confVerified\":\"~{pct}% chance it's here\",\"confLikely\":\"Lower chance it's here\",\"maybeLater\":\"Maybe later\",\"disclaimer\":\"Java Edition. Verified hotspots are high-confidence; likely veins are candidates, not guarantees.\",\"popupTitle\":\"{ore} hotspot\",\"clusterSize\":\"Marked spots: {count}\",\"selectOre\":\"Select ore\",\"dialogTitle\":\"Ore Finder\",\"oreLabel\":\"Ore\",\"accuracyLabel\":\"Accuracy: {pct}%\",\"accuracyTip\":\"Roughly how often a marked spot really has the ore in your game. The rest are close guesses.\",\"coordsLabel\":\"Your position\",\"yToggle\":\"Limit to a specific Y level\",\"yMin\":\"from\",\"yMax\":\"to\",\"yTooLow\":\"{ore} can't spawn below Y {min}.\",\"yTooHigh\":\"{ore} can't spawn above Y {max}.\",\"yEmpty\":\"Enter a Y level between {min} and {max}.\",\"yInvalid\":\"Enter a whole number for Y.\",\"yInverted\":\"The lowest Y must be at or below the highest.\",\"yRangeLabel\":\"Y range\",\"yRangeAll\":\"All\",\"yRangeMinLabel\":\"Lowest Y level to show\",\"yRangeMaxLabel\":\"Highest Y level to show\",\"friendlyNote\":\"This finder is very accurate, but not perfect — a few spots might be empty in your world.\",\"liveNote\":\"Ores appear automatically as you move the map. Very accurate, but not perfect — a few spots might be empty in your world.\",\"goTo\":\"Go to position\",\"find\":\"Find ore\",\"cancel\":\"Cancel\",\"scanningShort\":\"Scanning… {percent}%\",\"foundShort\":\"{count} found — search again\",\"noneShort\":\"No {ore} found here — try a different Y range or area\",\"coverageLabel\":\"Scan area\",\"coverageNormal\":\"Normal\",\"coverageLarge\":