2Fend_city.webp&amp;w=32&amp;q=75 1x, /_next/image?url=%2Fimages%2Fstructures%2Fend_city.webp&amp;w=64&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fstructures%2Fend_city.webp&amp;w=64&amp;q=75"/><strong>End City</strong></span></td><td class="is-r"><span class="ms-pb-num">99%</span></td><td class="is-r"><span class="ms-pb-num">99%</span></td></tr><tr><td><span class="ms-pb-nm"><img alt="" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="object-contain" style="color:transparent;width:32px;height:32px" srcSet="/_next/image?url=%2Fimages%2Fstructures%2Fmineshaft.webp&amp;w=32&amp;q=75 1x, /_next/image?url=%2Fimages%2Fstructures%2Fmineshaft.webp&amp;w=64&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fstructures%2Fmineshaft.webp&amp;w=64&amp;q=75"/><strong>Mineshaft</strong></span></td><td class="is-r"><span class="ms-pb-num">98%</span></td><td class="is-r"><span class="ms-pb-num">99%</span></td></tr><tr><td><span class="ms-pb-nm"><img alt="" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="object-contain" style="color:transparent;width:32px;height:32px" srcSet="/_next/image?url=%2Fimages%2Fstructures%2Fravine.webp&amp;w=32&amp;q=75 1x, /_next/image?url=%2Fimages%2Fstructures%2Fravine.webp&amp;w=64&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fstructures%2Fravine.webp&amp;w=64&amp;q=75"/><strong>Ravine</strong></span></td><td class="is-r"><span class="ms-pb-est">Estimate</span></td><td class="is-r"><span class="ms-pb-num">96%</span></td></tr><tr><td><span class="ms-pb-nm"><img alt="" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="object-contain" style="color:transparent;width:32px;height:32px" srcSet="/_next/image?url=%2Fimages%2Fstructures%2Fnether_fossil.webp&amp;w=32&amp;q=75 1x, /_next/image?url=%2Fimages%2Fstructures%2Fnether_fossil.webp&amp;w=64&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fstructures%2Fnether_fossil.webp&amp;w=64&amp;q=75"/><strong>Nether Fossil</strong></span></td><td class="is-r"><span class="ms-pb-num">99%</span></td><td class="is-r"><span class="ms-pb-est">Estimate</span></td></tr></tbody></table></div></div><p><strong>Estimate</strong> means the map will point you at the spot but will not put a number on it. Ravines, mineshafts and caves move about with the ground, so go and look, and dig a little either side of the marker. On Bedrock a few of the numbers sit a bit lower than on Java for the same seed.</p><div class="ms-pb-frow"><span class="ms-pb-lk"><a class="ms-map-popup-link ms-pb-link" href="/blog/minecraft-seed-map-accuracy">How accurate are Minecraft seed maps?</a></span><span class="ms-pb-mute ms-pb-small">how good it is, feature by feature</span></div></div></section><section class="ms-pb-sec" id="pb-s3" aria-labelledby="pb-s3-h" style="--pb-h0:max(0px, 1825px + -194.9 * 1vw);--pb-h1:max(0px, 1234px + -75.8 * 1vw);--pb-h2:max(0px, 1570px + -124.6 * 1vw);--pb-h3:max(0px, 690px + -7.1 * 1vw);--pb-h4:max(0px, 811px + -18.7 * min(1vw, 12.2px))"><div class="ms-pb-sh"><h2 id="pb-s3-h">How to use the Minecraft Seed Map</h2></div><div class="ms-pb-sb"><div class="ms-pb-blks"><div class="ms-pb-blk"><h3>Enter your seed</h3><p>Use the toolbar above the map to enter your <strong>world seed</strong>, then choose the <strong>edition</strong> (Java, Large Biomes or Bedrock), the exact <strong>version</strong>, and the <strong>dimension</strong> (Overworld, Nether or End). You can also load a Java <code>level.dat</code> file to auto-fill the seed and version, or use the random button to generate a new seed. The map updates immediately.</p></div><div class="ms-pb-blk"><h3>Pick edition, version and dimension</h3><p>Java, Large Biomes or Bedrock, then the exact version your world was made in, then Overworld, Nether or End. Minecraft changed the shape of its worlds at 1.13, 1.15 and 1.18, so a 1.12 world and a 1.18 world from the same seed look nothing alike.</p></div><div class="ms-pb-blk"><h3>Mouse, keyboard and touch</h3><div class="ms-pb-cols3"><div><span class="ms-map-kick ms-pb-kick">Mouse</span><ul><li><strong>Drag</strong>: pan the map</li><li><strong>Scroll wheel</strong>: zoom in and out</li><li><strong>Click a marker</strong>: show the structure details popup</li><li><strong>Right-click</strong>: drop a pin that you can name and save</li><li><strong>Double-click</strong>: zoom in at that point</li></ul></div><div><span class="ms-map-kick ms-pb-kick">Keyboard</span><ul><li><strong>Arrow keys</strong>: pan the map</li><li><strong>+ / −</strong>: zoom in and out</li><li><strong>F</strong>: toggle fullscreen map view</li><li><strong>Esc</strong>: exit fullscreen and close popups</li><li><strong>/</strong> jumps to the seed box</li></ul></div><div><span class="ms-map-kick ms-pb-kick">Touch</span><ul><li><strong>Drag</strong>: pan the map</li><li><strong>Pinch</strong>: zoom in and out</li><li><strong>Tap a marker</strong>: show its details</li><li><strong>Tap and hold</strong>: drop a pin</li></ul></div></div></div><div class="ms-pb-blk"><h3>Save what you find</h3><p>Your pins are your own: drop one anywhere, give it a name, and it waits in My pins. Ticking off is for what the map found for you: press Tick off on a structure or an ore and its marker greys out and moves to Ticked off. Both stay in this browser along with your view, so the map opens where you left off. Share the link with a friend and they get the same seed, dimension, place and zoom.</p></div></div></div></section><section class="ms-pb-sec" id="pb-s4" aria-labelledby="pb-s4-h" style="--pb-h0:max(0px, 2874px + -46.5 * 1vw);--pb-h1:max(0px, 2728px + -16.1 * 1vw);--pb-h2:max(0px, 2615px + 0 * 1vw);--pb-h3:max(0px, 2119px + 0 * 1vw);--pb-h4:max(0px, 1979px + -10 * min(1vw, 12.2px))"><div class="ms-pb-sh"><h2 id="pb-s4-h">Find a structure</h2></div><div class="ms-pb-sb"><p>Light a structure up on the row under the map and every one of them shows, with how far it is from where you are standing. Each one has a finder page of