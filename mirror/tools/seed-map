ed\":\"Copied!\",\"copyImage\":\"Copy image\",\"downloadImage\":\"Download image\",\"saved\":\"Saved!\",\"exportCsv\":\"CSV\",\"exportJson\":\"JSON\",\"exportGeoJson\":\"GeoJSON\",\"exportEmpty\":\"No structures loaded — zoom/pan the map to load some, then export.\",\"copyLink\":\"Copy link\",\"copyVideoDescription\":\"Copy for video description\",\"copyReddit\":\"Copy for Reddit\",\"fmtSeed\":\"Seed\",\"fmtVersion\":\"Version\",\"fmtCoordinates\":\"Coordinates\",\"fmtOpenMap\":\"Open this exact map view\",\"includeSeedVersion\":\"Include seed and version\",\"includePosition\":\"Include position\",\"includeZoom\":\"Include zoom level\",\"includeMarkers\":\"Include pins ({count})\",\"includeMarkersPartial\":\"Include pins ({visible} of {total})\",\"layout_wide\":\"Wide\",\"layout_square\":\"Square\",\"layout_map\":\"Just the map\",\"foundByLabel\":\"Found by\",\"foundByPlaceholder\":\"Your Minecraft name\",\"foundByHint\":\"Take credit for your find with your Minecraft name. It goes on the picture and in the link.\",\"foundByRefused\":\"That name can't go on a picture. Try your Minecraft name.\",\"foundByLine\":\"Found by {name}\"},\"accuracy\":{\"heading\":\"Accuracy\",\"estimate\":\"Estimate\",\"tooltipSulfurBedrock\":\"How often a real sulfur cave lies below this marker.\",\"tooltip\":\"How reliably this marker matches the real game.\"},\"trust\":{\"tldr\":\"The Minecraft Seed Map shows the biomes, structures and ores of any world from its seed — free, in your browser, with no download, for Java and Bedrock. Structure markers are verified up to {maxAccuracy}% accurate (villages, strongholds and ocean monuments), and the map is current for Minecraft 26.3 (Java) and 1.26.60 (Bedrock).\",\"accuracyHeadline\":\"Verified up to {maxAccuracy}% accurate\",\"accuracyScope\":\"villages, strongholds \u0026 monuments\",\"accuracyExplainerAria\":\"How accurate are the seed map markers?\",\"accuracyExplainer\":\"Every marker shows its own verified accuracy the moment you open it — up to {maxAccuracy}% for villages, strongholds and monuments, and lower for a few harder types. A marker differs from your world mainly when the version or edition is wrong (Java and Bedrock place structures differently on the same seed), so reselect the matching one to fix it. A few features are chunk-centre estimates, and on rare occasions a marker can fail to render — reloading the page fixes that.\",\"versionsPrefix\":\"Updated for\",\"free\":\"Free · No download\"},\"structurePopup\":{\"coordinates\":\"Coordinates\",\"mobs\":\"Mobs\",\"moreMobs\":\"+{count} more\",\"copyTpCommand\":\"Copy /tp command\",\"structureWiki\":\"Structure Wiki\",\"biomeWiki\":\"Biome Wiki\",\"markAsCompleted\":\"Mark as completed\",\"widthLabel\":\"Width\",\"showVeinBlocks\":\"Zoom in to see the whole vein\",\"depth\":\"Depth\",\"depthRange\":\"Y {min} to {max}\",\"depthTooltip\":\"Mineshafts sprawl underground with no single Y — dig to this range near the marker and explore. It is the range we measured, not a hard limit.\",\"fossilDepth\":\"{min}–{max} blocks under the ground, sometimes deeper\",\"fossilDepthTooltip\":\"Coal fossils have no fixed height: they sit under the ground. Stand on the ground at the marker (the bottom, if there is water), dig down {min}–{max} blocks and look a few blocks around. Some lie deeper.\",\"secretChest\":\"Secret chest\",\"secretChestTooltip\":\"This camp's campsite holds an {chest} with the camp's secret loot. Right for {percent}% of camps against the real game.\",\"campPieces\":\"Pieces\",\"campPiecesValue\":\"Tent {tent} · {kind, select, chest {Chest campsite {campsite}} barrel {Barrel campsite {campsite}} special {Special campsite {campsite}} other {{biome} campsite {campsite}}}\",\"contents\":{\"kicker\":\"What's inside\",\"chests\":\"{count, plural, one {# chest} other {# chests}}\",\"chestsUnknown\":\"{count, plural, one {# chest} other {# chests}} · {unknown} unknown\",\"loading\":\"Opening the chests…\",\"slow\":\"Strongholds take longer